      {"name":"Update Customer Status","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/admin/customers/{{customer_id}}/status","body":{"mode":"raw","raw":"{\\n  \\\"isActive\\\": true\\n}"}}},
      {"name":"List Owners","request":{"method":"GET","url":"{{gateway_base}}/api/admin/owners"}},
