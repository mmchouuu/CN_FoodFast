      {"name":"Create Tax Template","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/admin/catalog/taxes/templates","body":{"mode":"raw","raw":"{\\n  \\\"code\\\": \\\"VAT7_DEFAULT\\\",\\n  \\\"name\\\": \\\"VAT 7%\\\"\\n}"}}},
      {"name":"Create Calendar","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/admin/catalog/calendars","body":{"mode":"raw","raw":"{\\n  \\\"code\\\": \\\"HOLIDAY\\\",\\n  \\\"name\\\": \\\"Holiday\\\",\\n  \\\"dates\\\": [ { \\\"date\\\": \\\"2025-12-25\\\", \\\"name\\\": \\\"Xmas\\\" } ]\\n}"}}},
      {"name":"Assign Restaurant Tax","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/admin/catalog/taxes/assignments","body":{"mode":"raw","raw":"{\\n  \\\"scope\\\": \\\"restaurant\\\",\\n  \\\"restaurantId\\\": \\\"{{restaurant_id}}\\\",\\n  \\\"taxTemplateId\\\": \\\"{{tax_template_id}}\\\",\\n  \\\"rate\\\": 7\\n}"}}}
    ]}
