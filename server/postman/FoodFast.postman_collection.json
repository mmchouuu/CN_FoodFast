  "item": [
    {"name": "Health", "item": [ {"name": "Gateway Health", "request": {"method": "GET", "url": "{{gateway_base}}/health"} } ]},
    {"name": "Customer","item": [
      {"name":"Signup","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/customers/signup","body":{"mode":"raw","raw":"{\n  \"email\": \"{{customer_email}}\",\n  \"password\": \"P@ssw0rd!\",\n  \"firstName\": \"{{customer_first}}\",\n  \"lastName\": \"{{customer_last}}\"\n}"}},"event":[{"listen":"test","script":{"exec":["pm.test('customer signup accepted', function () { pm.response.to.have.status(201); });"]}}]},
      {"name":"Verify Email","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/customers/verify","body":{"mode":"raw","raw":"{\n  \"email\": \"{{customer_email}}\",\n  \"otp\": \"{{customer_otp}}\"\n}"}},"event":[{"listen":"test","script":{"exec":["pm.test('verified', function(){ pm.response.to.have.status(200); });","var data = pm.response.json();","pm.environment.set('customer_token', data.token);"]}}]},
      {"name":"Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/customers/login","body":{"mode":"raw","raw":"{\n  \"email\": \"{{customer_email}}\",\n  \"password\": \"P@ssw0rd!\"\n}"}},"event":[{"listen":"test","script":{"exec":["pm.test('login ok', function(){ pm.response.to.have.status(200); });","var data = pm.response.json();","pm.environment.set('customer_token', data.token);"]}}]},
      {"name":"Addresses - List","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{customer_token}}"}],"url":"{{gateway_base}}/api/customers/addresses"}},
      {"name":"Addresses - Create","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{customer_token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/customers/addresses","body":{"mode":"raw","raw":"{\n  \"label\": \"Home\",\n  \"street\": \"1 Example St\",\n  \"city\": \"HCM\",\n  \"isDefault\": true\n}"}},"event":[{"listen":"test","script":{"exec":["pm.test('address created', function(){ pm.response.to.have.status(201); });","var a = pm.response.json(); pm.environment.set('customer_address_id', a.id || a.address?.id);"]}}]},
      {"name":"Addresses - Delete","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{customer_token}}"}],"url":"{{gateway_base}}/api/customers/addresses/{{customer_address_id}}"}}
    ]},
    {"name":"Owner","item":[
      {"name":"Owner Signup","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/restaurants/signup","body":{"mode":"raw","raw":"{\n  \"email\": \"{{owner_email}}\",\n  \"password\": \"P@ssw0rd!\",\n  \"firstName\": \"{{owner_first}}\",\n  \"lastName\": \"{{owner_last}}\",\n  \"legalName\": \"{{owner_legal}}\",\n  \"taxCode\": \"{{owner_tax}}\",\n  \"companyAddress\": \"{{owner_company_addr}}\"\n}"}}},
      {"name":"Owner Verify Email","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/restaurants/verify","body":{"mode":"raw","raw":"{\n  \"email\": \"{{owner_email}}\",\n  \"otp\": \"{{owner_otp}}\"\n}"}}},
      {"name":"Owner Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/restaurants/login","body":{"mode":"raw","raw":"{\n  \"email\": \"{{owner_email}}\",\n  \"password\": \"P@ssw0rd!\"\n}"}},"event":[{"listen":"test","script":{"exec":["var data = pm.response.json(); pm.environment.set('owner_token', data.token);"]}}]},
      {"name":"Create Restaurant","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/restaurants","body":{"mode":"raw","raw":"{\n  \"ownerUserId\": \"{{owner_user_id}}\",\n  \"name\": \"{{restaurant_name}}\",\n  \"phone\": \"0900000000\",\n  \"ownerMainAccount\": { \"loginEmail\": \"{{owner_main_email}}\" },\n  \"branches\": [ { \"street\": \"10 District 1\", \"city\": \"HCM\" } ],\n  \"defaultCategory\": { \"name\": \"Uncategorized\" }\n}"}},"event":[{"listen":"test","script":{"exec":["pm.test('restaurant created', function(){ pm.response.to.have.status(201); });","var d = pm.response.json(); pm.environment.set('restaurant_id', d.restaurant.id);"]}}]},
      {"name":"Create Branch","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/restaurants/{{restaurant_id}}/branches","body":{"mode":"raw","raw":"{\n  \"street\": \"22 District 3\",\n  \"city\": \"HCM\",\n  \"isOpen\": true\n}"}},"event":[{"listen":"test","script":{"exec":["var b = pm.response.json(); pm.environment.set('branch_id', b.id || b.branch?.id);"]}}]},
      {"name":"Update Branch Schedules","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/restaurants/{{restaurant_id}}/branches/{{branch_id}}/schedules","body":{"mode":"raw","raw":"{\n  \"openingHours\": [{ \"dayOfWeek\": 1, \"openTime\": \"08:00\", \"closeTime\": \"22:00\" }],\n  \"specialHours\": []\n}"}}},
      {"name":"Create Category","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/restaurants/{{restaurant_id}}/categories","body":{"mode":"raw","raw":"{\n  \"name\": \"Noodles\"\n}"}},"event":[{"listen":"test","script":{"exec":["var c = pm.response.json(); pm.environment.set('category_id', c.id);"]}}]},
      {"name":"Create Product","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/restaurants/{{restaurant_id}}/products","body":{"mode":"raw","raw":"{\n  \"title\": \"Pho Bo\",\n  \"basePrice\": 75000,\n  \"categoryId\": \"{{category_id}}\"\n}"}},"event":[{"listen":"test","script":{"exec":["var p = pm.response.json(); pm.environment.set('product_id', p.id);"]}}]},
      {"name":"Create Option Group","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/restaurants/{{restaurant_id}}/products/{{product_id}}/options","body":{"mode":"raw","raw":"{\n  \"restaurantId\": \"{{restaurant_id}}\",\n  \"name\": \"Toppings\",\n  \"items\": [ { \"name\": \"Egg\", \"priceDelta\": 7000 } ]\n}"}}},
      {"name":"Create Combo","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/restaurants/{{restaurant_id}}/combos","body":{"mode":"raw","raw":"{\n  \"name\": \"Lunch Set\",\n  \"basePrice\": 120000,\n  \"groups\": [ { \"name\": \"Main\", \"items\": [ { \"itemType\": \"product\", \"productId\": \"{{product_id}}\" } ] } ]\n}"}}},
      {"name":"Create Restaurant Promotion","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{gateway_base}}/api/restaurants/{{restaurant_id}}/promotions","body":{"mode":"raw","raw":"{\n  \"name\": \"Happy Hour\",\n  \"promoType\": \"order\",\n  \"discountType\": \"percent\",\n  \"discountValue\": 10\n}"}}}
    ]},
