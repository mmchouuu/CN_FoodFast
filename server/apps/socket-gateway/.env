LAN_IP=26.62.36.103
PORT=4000
NODE_ENV=development

# RabbitMQ để nhận sự kiện và emit ra socket
RABBITMQ_URL=amqp://guest:guest@26.62.36.103:5672
RABBITMQ_QUEUE=socket_events

# HTTPS cấu hình cho socket gateway
SOCKET_HTTPS_ENABLED=true
SOCKET_SSL_CERT_PATH=./certs/lan-dev.pem
SOCKET_SSL_KEY_PATH=./certs/lan-dev-key.pem

APP_NAME=SocketGateway

